.

ihfc:temperature-corrections
    a skos:ConceptScheme ;
    dcterms:creator <https://ihfc-iugg.org/> ;
    dcterms:description "Methods used to correct measured temperatures for disturbances, such as those caused by drilling, before heat flow is derived."@en ;
    dcterms:isPartOf <https://doi.org/10.5880/fidgeo.2026.065> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://ror.org/04z8jg394> ;
    dcterms:source
        <https://doi.org/10.1016/j.tecto.2023.229976> ,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    rdfs:seeAlso <https://github.com/ihfc-iugg/ihfc-vocabularies> ;
    skos:hasTopConcept
        :aapg ,
        :cylinderSource ,
        :hornerPlot ,
        :inverseNM ,
        :lineSourceExplosion ,
        :not_corrected ,
        :other ,
        :unspecified ;
    skos:prefLabel "Temperature correction methods"@en ;
    skos:scopeNote "Lists the values allowed in the fields T_corr_top and T_corr_bottom of the Global Heat Flow Database."@en ;
.

:aapg
    a skos:Concept ;
    skos:definition "Empirical correction of bottom-hole temperatures as a function of depth, published by Harrison and others in 1983 and used for the AAPG Geothermal Survey of North America database."@en ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "AAPG correction"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:cylinderSource
    a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "Correction of a drilling disturbance by modelling the borehole as a cylindrical heat source that cools to the formation temperature after drilling."@en ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Cylinder source method"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:hornerPlot
    a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "Correction of a bottom-hole temperature by plotting temperature against the logarithm of a time ratio, using the time since circulation stopped, and extrapolating to the undisturbed formation temperature."@en ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Horner plot"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:inverseNM
    a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "Correction of a drilling disturbance by numerically modelling the temperature recovery and adjusting the model until it fits the measured temperatures."@en ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Inverse numerical modelling"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:lineSourceExplosion
    a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "Correction of a drilling disturbance by modelling the borehole as a line source of heat that relaxes after drilling."@en ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Line source explosion method"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:not_corrected
    a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "No correction for drilling perturbations was applied to the temperature."@en ;
    skos:hiddenLabel "not corrected"@en ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Not corrected"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:other
    a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "A published correction that is not listed. The author or DOI must be given in the comment field."@en ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Other published correction"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:unspecified
    a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "A correction was applied but the method is not specified."@en ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.
