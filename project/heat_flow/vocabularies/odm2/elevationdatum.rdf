<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dc="http://purl.org/dc/elements/1.1/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://vocabulary.odm2.org/elevationdatum/AHD">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://vocabulary.odm2.org/elevationdatum"/>
    <skos:prefLabel>AHD</skos:prefLabel>
    <skos:definition>Australian Height Datum. Height datum used for standardised elevations across Australia. The datum surface is defined as that which passes through mean sea level at the 30 specified tide gauges and through points at zero AHD height vertically below the other basic junction points.</skos:definition>
    <skos:historyNote>See http://www.ga.gov.au/scientific-topics/positioning-navigation/geodesy/geodetic-datums/australian-height-datum-ahd</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabulary.odm2.org/elevationdatum/MSL">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://vocabulary.odm2.org/elevationdatum"/>
    <skos:prefLabel>MSL</skos:prefLabel>
    <skos:definition>Mean Sea Level</skos:definition>
    <skos:historyNote>Originally from CUAHSI HIS ODM CV. See http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VerticalDatumCV.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabulary.odm2.org/elevationdatum/NGVD29">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://vocabulary.odm2.org/elevationdatum"/>
    <skos:prefLabel>NGVD29</skos:prefLabel>
    <skos:definition>National Geodetic Vertical Datum of 1929</skos:definition>
    <skos:historyNote>Originally from CUAHSI HIS ODM CV. See http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VerticalDatumCV.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabulary.odm2.org/elevationdatum/EGM96">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://vocabulary.odm2.org/elevationdatum"/>
    <skos:prefLabel>EGM96</skos:prefLabel>
    <skos:definition>EGM96 (Earth Gravitational Model 1996) is a geopotential model of the Earth consisting of spherical harmonic coefficients complete to degree and order 360.</skos:definition>
    <skos:historyNote>See https://en.wikipedia.org/wiki/EGM96</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabulary.odm2.org/elevationdatum/Unknown">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://vocabulary.odm2.org/elevationdatum"/>
    <skos:prefLabel>Unknown</skos:prefLabel>
    <skos:definition>The vertical datum is unknown</skos:definition>
    <skos:historyNote>Originally from CUAHSI HIS ODM CV. See http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VerticalDatumCV.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabulary.odm2.org/elevationdatum">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dc:title>ODM2 Elevation Datum Controlled Vocabulary</dc:title>
    <dc:creator>ODM2 Working Group</dc:creator>
    <dc:description>A vocabulary for describing vertical datums. Vertical datums are used in ODM2 to specify the origin for elevations assocated with SamplingFeatures.</dc:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabulary.odm2.org/elevationdatum/NAVD88">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://vocabulary.odm2.org/elevationdatum"/>
    <skos:prefLabel>NAVD88</skos:prefLabel>
    <skos:definition>North American Vertical Datum of 1988</skos:definition>
    <skos:historyNote>Originally from CUAHSI HIS ODM CV. See http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VerticalDatumCV.</skos:historyNote>
  </rdf:Description>
</rdf:RDF>
