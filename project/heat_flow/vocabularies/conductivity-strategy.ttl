ihfc:conductivity-strategy
    a skos:ConceptScheme ;
    dcterms:creator <https://ihfc-iugg.org/> ;
    dcterms:description "The strategy used to obtain thermal conductivity values for the depth interval of a heat-flow determination."@en ;
    dcterms:isPartOf <https://doi.org/10.5880/fidgeo.2026.065> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://ror.org/04z8jg394> ;
    dcterms:source
        <https://doi.org/10.1016/j.tecto.2023.229976> ,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    rdfs:seeAlso <https://github.com/ihfc-iugg/ihfc-vocabularies> ;
    skos:hasTopConcept
        :characterize ,
        :computation ,
        :other ,
        :random ,
        :unspecified ,
        :well_log ;
    skos:prefLabel "Thermal conductivity strategies"@en ;
    skos:scopeNote "Lists the values allowed in the field tc_strategy of the Global Heat Flow Database."@en ;
.

:characterize
    a skos:Concept ;
    skos:definition "The conductivity of each formation in the heat-flow interval was characterized from samples, and the interval value was derived from the formation values."@en ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Characterize formation conductivities"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

:computation
    a skos:Concept ;
    skos:definition "The conductivity over the heat-flow interval was computed from probe sensing measurements."@en ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Computation from probe sensing"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

:other
    a skos:Concept ;
    skos:definition "The conductivity over the heat-flow interval was estimated by a strategy not listed here. Describe it in the comment field."@en ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

:random
    a skos:Concept ;
    skos:altLabel "Random or periodic depth sampling (number)"@en ;
    skos:definition "The conductivity was obtained from samples or measurements taken at random or regular depths along the heat-flow interval. Give the number in the comment field."@en ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Random or periodic depth sampling"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

:unspecified
    a skos:Concept ;
    skos:definition "The strategy used to estimate the conductivity is not specified."@en ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

:well_log
    a skos:Concept ;
    skos:definition "The conductivity over the heat-flow interval was derived by interpreting well logs."@en ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Well log interpretation"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.
