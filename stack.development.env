# These env vars are read in during development mode (i.e. when using py manage.py ...)
# Change these to customise the behaviour of the app during development
PYTHONUTF8=1

# DJANGO SETTINGS
# -------------------------------------
DJANGO_DEBUG=True
DJANGO_SUPERUSER_EMAIL=super.user@example.com
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SETTINGS_MODULE=tests.settings

# DJANGO_SUPERUSER_FIRST_NAME=Super
# DJANGO_SUPERUSER_LAST_NAME=User
SHOW_DEBUG_TOOLBAR=False
# DJANGO_CACHE=False
DJANGO_SITE_NAME=Heatflow.world
DJANGO_SECURE=False

# DATABASE
# -------------------------------------
# The `postgres` service of docker-compose.yml, published on localhost. The `django` service
# sets POSTGRES_HOST=postgres itself, and a variable already set is never overwritten here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ghfdb
