PREFIX : <https://w3id.org/fairdm/vocabularies/sample-relation-types/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fairdm: <https://w3id.org/fairdm/vocabularies/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<https://www.fairdm.org/>
    a foaf:Organization ;
    foaf:homepage <https://www.fairdm.org/> ;
    foaf:name "FairDM"@en ;
.

fairdm:sample-relation-types
    a skos:ConceptScheme ;
    dcterms:creator <https://www.fairdm.org/> ;
    dcterms:description "How one physical sample relates to another."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://www.fairdm.org/> ;
    rdfs:seeAlso <https://github.com/FAIR-DM/fairdm-vocabularies> ;
    skos:hasTopConcept :child-of ;
    skos:prefLabel "Sample relation types"@en ;
.

:child-of
    a skos:Concept ;
    skos:definition "The sample was taken from the related sample, as a subsample or a part of it."@en ;
    skos:inScheme fairdm:sample-relation-types ;
    skos:notation "child_of" ;
    skos:prefLabel "child of"@en ;
    skos:topConceptOf fairdm:sample-relation-types ;
.
