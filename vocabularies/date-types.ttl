PREFIX : <https://w3id.org/fairdm/vocabularies/date-types/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fairdm: <https://w3id.org/fairdm/vocabularies/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<https://www.fairdm.org/>
    a foaf:Organization ;
    foaf:homepage <https://www.fairdm.org/> ;
    foaf:name "FairDM"@en ;
.

fairdm:date-types
    a skos:ConceptScheme ;
    dcterms:creator <https://www.fairdm.org/> ;
    dcterms:description "Kinds of date recorded for projects, datasets, samples and measurements, such as when a dataset was published or a sample was collected."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://www.fairdm.org/> ;
    rdfs:seeAlso <https://github.com/FAIR-DM/fairdm-vocabularies> ;
    skos:hasTopConcept
        :archival ,
        :available ,
        :collected ,
        :collection-end ,
        :collection-start ,
        :created ,
        :destroyed ,
        :end ,
        :prepared ,
        :published ,
        :restored ,
        :returned ,
        :setup ,
        :start ,
        :submitted ,
        :tear-down ,
        :withdrawn ;
    skos:prefLabel "Date types"@en ;
.

:dataset
    a skos:OrderedCollection ;
    skos:definition "Important dates regarding archival of metadata related to dataset management."@en ;
    skos:memberList (
        :available
        :collection-start
        :collection-end
        :submitted
        :published
        :withdrawn
    ) ;
    skos:prefLabel "Dataset Dates"@en ;
.

:measurement
    a skos:OrderedCollection ;
    skos:definition "Important dates regarding archival of metadata related to measurement management."@en ;
    skos:memberList (
        :setup
        :tear-down
    ) ;
    skos:prefLabel "Measurement Dates"@en ;
.

:project
    a skos:OrderedCollection ;
    skos:definition "Important dates regarding archival of metadata related to project management."@en ;
    skos:memberList (
        :start
        :end
    ) ;
    skos:prefLabel "Project Dates"@en ;
.

:sample
    a skos:OrderedCollection ;
    skos:definition "Important dates regarding archival of metadata related to sample management."@en ;
    skos:memberList (
        :created
        :destroyed
        :collected
        :returned
        :prepared
        :archival
        :restored
    ) ;
    skos:prefLabel "Sample Dates"@en ;
.

:archival
    a skos:Concept ;
    skos:definition "The date on which the sample was stored"@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Archival" ;
    skos:prefLabel "Storage date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:available
    a skos:Concept ;
    skos:definition "The date on which the dataset becomes available to the public."@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Available" ;
    skos:prefLabel "Date Available"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:collected
    a skos:Concept ;
    skos:definition "The date on which the sample was collected"@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Collected" ;
    skos:prefLabel "Collection date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:collection-end
    a skos:Concept ;
    skos:definition "The date on which the data collection process ended."@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "CollectionEnd" ;
    skos:prefLabel "Collection End Date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:collection-start
    a skos:Concept ;
    skos:definition "The date on which the data collection process began."@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "CollectionStart" ;
    skos:prefLabel "Collection Start Date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:created
    a skos:Concept ;
    skos:definition "The date on which the sample was created"@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Created" ;
    skos:prefLabel "Creation date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:destroyed
    a skos:Concept ;
    skos:definition "The date on which the sample was destroyed"@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Destroyed" ;
    skos:prefLabel "Destruction date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:end
    a skos:Concept ;
    skos:definition "The official end date of the project."@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "End" ;
    skos:prefLabel "End Date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:prepared
    a skos:Concept ;
    skos:definition "The date on which the sample was prepared for analysis"@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Prepared" ;
    skos:prefLabel "Preparation date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:published
    a skos:Concept ;
    skos:definition "The date on which the dataset was published."@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Published" ;
    skos:prefLabel "Publication Date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:restored
    a skos:Concept ;
    skos:definition "The date on which the sample was restored"@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Restored" ;
    skos:prefLabel "Restoration date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:returned
    a skos:Concept ;
    skos:definition "The date on which the sample was returned"@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Returned" ;
    skos:prefLabel "Return date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:setup
    a skos:Concept ;
    skos:definition "The date on which the measurement setup was completed"@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Setup" ;
    skos:prefLabel "Setup date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:start
    a skos:Concept ;
    skos:definition "The official start date of the project."@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Start" ;
    skos:prefLabel "Start Date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:submitted
    a skos:Concept ;
    skos:definition "The date on which the dataset was submitted for publication."@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Submitted" ;
    skos:prefLabel "Submission Date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:tear-down
    a skos:Concept ;
    skos:definition "The date on which the measurement teardown was completed"@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "TearDown" ;
    skos:prefLabel "Tear down date"@en ;
    skos:topConceptOf fairdm:date-types ;
.

:withdrawn
    a skos:Concept ;
    skos:definition "The date on which the dataset was withdrawn from publication."@en ;
    skos:inScheme fairdm:date-types ;
    skos:notation "Withdrawn" ;
    skos:prefLabel "Withdrawal Date"@en ;
    skos:topConceptOf fairdm:date-types ;
.
