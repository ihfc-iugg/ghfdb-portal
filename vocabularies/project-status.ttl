PREFIX : <https://w3id.org/fairdm/vocabularies/project-status/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fairdm: <https://w3id.org/fairdm/vocabularies/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<https://www.fairdm.org/>
    a foaf:Organization ;
    foaf:homepage <https://www.fairdm.org/> ;
    foaf:name "FairDM"@en ;
.

fairdm:project-status
    a skos:ConceptScheme ;
    dcterms:creator <https://www.fairdm.org/> ;
    dcterms:description "The stages a research project moves through, from first idea to completion."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://www.fairdm.org/> ;
    rdfs:seeAlso <https://github.com/FAIR-DM/fairdm-vocabularies> ;
    skos:hasTopConcept
        :complete ,
        :concept ,
        :in-progress ,
        :planning ,
        :searching-for-collaborators ;
    skos:prefLabel "Project status"@en ;
.

:complete
    a skos:Concept ;
    skos:definition "The project's work has finished."@en ;
    skos:inScheme fairdm:project-status ;
    skos:notation "3" ;
    skos:prefLabel "Complete"@en ;
    skos:topConceptOf fairdm:project-status ;
.

:concept
    a skos:Concept ;
    skos:definition "The project is an idea that has not yet been planned."@en ;
    skos:inScheme fairdm:project-status ;
    skos:notation "0" ;
    skos:prefLabel "Concept"@en ;
    skos:topConceptOf fairdm:project-status ;
.

:in-progress
    a skos:Concept ;
    skos:definition "The project has started and its work is under way."@en ;
    skos:inScheme fairdm:project-status ;
    skos:notation "2" ;
    skos:prefLabel "In progress"@en ;
    skos:topConceptOf fairdm:project-status ;
.

:planning
    a skos:Concept ;
    skos:definition "The project is being planned and has not yet started."@en ;
    skos:inScheme fairdm:project-status ;
    skos:notation "1" ;
    skos:prefLabel "Planning"@en ;
    skos:topConceptOf fairdm:project-status ;
.

:searching-for-collaborators
    a skos:Concept ;
    skos:definition "The project is looking for people or organizations to take part in it."@en ;
    skos:inScheme fairdm:project-status ;
    skos:notation "4" ;
    skos:prefLabel "Searching for collaborators"@en ;
    skos:topConceptOf fairdm:project-status ;
.
