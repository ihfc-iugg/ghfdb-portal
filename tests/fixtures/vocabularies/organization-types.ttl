PREFIX : <https://w3id.org/fairdm/vocabularies/organization-types/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fairdm: <https://w3id.org/fairdm/vocabularies/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<https://ror.readme.io/docs/ror-data-structure>
    a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Research Organization Registry (ROR). ROR data structure, metadata schema version 2.1. https://ror.readme.io/docs/ror-data-structure"@en ;
.

<https://www.fairdm.org/>
    a foaf:Organization ;
    foaf:homepage <https://www.fairdm.org/> ;
    foaf:name "FairDM"@en ;
.

fairdm:organization-types
    a skos:ConceptScheme ;
    dcterms:creator <https://www.fairdm.org/> ;
    dcterms:description "The kind of institution an organization is, from the organization types of the Research Organization Registry (ROR)."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://www.fairdm.org/> ;
    dcterms:source <https://ror.readme.io/docs/ror-data-structure> ;
    rdfs:seeAlso <https://github.com/FAIR-DM/fairdm-vocabularies> ;
    skos:hasTopConcept
        :archive ,
        :company ,
        :education ,
        :facility ,
        :funder ,
        :government ,
        :healthcare ,
        :nonprofit ,
        :other ;
    skos:prefLabel "Organization types"@en ;
.

:archive
    a skos:Concept ;
    skos:definition "An organization involved in stewarding research and cultural heritage materials. Includes libraries, museums, and zoos."@en ;
    skos:inScheme fairdm:organization-types ;
    skos:notation "archive" ;
    skos:prefLabel "Archive"@en ;
    skos:topConceptOf fairdm:organization-types ;
.

:company
    a skos:Concept ;
    skos:definition "A private for-profit corporate entity involved in conducting or sponsoring research."@en ;
    skos:inScheme fairdm:organization-types ;
    skos:notation "company" ;
    skos:prefLabel "Company"@en ;
    skos:topConceptOf fairdm:organization-types ;
.

:education
    a skos:Concept ;
    skos:definition "A university or similar institution involved in providing education and educating/employing researchers."@en ;
    skos:inScheme fairdm:organization-types ;
    skos:notation "education" ;
    skos:prefLabel "Education"@en ;
    skos:topConceptOf fairdm:organization-types ;
.

:facility
    a skos:Concept ;
    skos:definition "A specialized facility where research takes place, such as a laboratory or telescope or dedicated research area."@en ;
    skos:inScheme fairdm:organization-types ;
    skos:notation "facility" ;
    skos:prefLabel "Facility"@en ;
    skos:topConceptOf fairdm:organization-types ;
.

:funder
    a skos:Concept ;
    skos:definition "An organization that awards research funds or provides in-kind support."@en ;
    skos:inScheme fairdm:organization-types ;
    skos:notation "funder" ;
    skos:prefLabel "Funder"@en ;
    skos:topConceptOf fairdm:organization-types ;
.

:government
    a skos:Concept ;
    skos:definition "An organization that is part of or operated by a national or regional government and that conducts or supports research."@en ;
    skos:inScheme fairdm:organization-types ;
    skos:notation "government" ;
    skos:prefLabel "Government"@en ;
    skos:topConceptOf fairdm:organization-types ;
.

:healthcare
    a skos:Concept ;
    skos:definition "A medical care facility such as hospital or medical clinic. Excludes medical schools, which should be categorized as education."@en ;
    skos:inScheme fairdm:organization-types ;
    skos:notation "healthcare" ;
    skos:prefLabel "Healthcare"@en ;
    skos:topConceptOf fairdm:organization-types ;
.

:nonprofit
    a skos:Concept ;
    skos:definition "A non-profit and non-governmental organization involved in conducting or funding research."@en ;
    skos:inScheme fairdm:organization-types ;
    skos:notation "nonprofit" ;
    skos:prefLabel "Nonprofit"@en ;
    skos:topConceptOf fairdm:organization-types ;
.

:other
    a skos:Concept ;
    skos:definition "An organization that does not fit any of the other types."@en ;
    skos:inScheme fairdm:organization-types ;
    skos:notation "other" ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf fairdm:organization-types ;
.
