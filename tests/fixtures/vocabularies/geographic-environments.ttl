@prefix : <https://w3id.org/ihfc-iugg/vocabularies/geographic-environments/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ihfc: <https://w3id.org/ihfc-iugg/vocabularies/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:offshore a skos:Collection ;
    skos:definition "Environments where the site lies under the sea."@en ;
    skos:member :offshore_continental,
        :offshore_marine ;
    skos:prefLabel "Offshore environments"@en .

:onshore a skos:Collection ;
    skos:definition "Environments where the site lies on land, including under inland water."@en ;
    skos:member :onshore_continental,
        :onshore_marine ;
    skos:prefLabel "Onshore environments"@en .

<https://doi.org/10.1016/j.tecto.2023.229976> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Norden, B., Neumann, F., Kaul, N., Tanaka, A., Kukkonen, I. T., et al. (2023). Quality-assurance of heat-flow data: The new structure and evaluation scheme of the IHFC Global Heat Flow Database. Tectonophysics, 863, 229976."@en .

<https://doi.org/10.31214/ijthfa.v4i1.62> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Beardsmore, G., Chiozzi, P., Espinoza-Ojeda, O. M., Gola, G., Gosnold, W., Harris, R., Jennings, S., Liu, S., Negrete-Aranda, R., Neumann, F., Norden, B., Poort, J., Rajver, D., Ray, L., Richards, M., Smith, J., Tanaka, A., and Verdoya, M. (2021). A new database structure for the IHFC Global Heat Flow Database. International Journal of Terrestrial Heat Flow and Applied Geothermics, 4(1), 1–14."@en .

<https://doi.org/10.5880/fidgeo.2026.065> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Jennings, Samuel; Neumann, Florian; Norden, Ben; Balkan-Pazvantoğlu, Elif; Elbarbary, Samah; Petrunin, Alexey G.; Elger, Kirsten; Fuchs, Sven (2026): IHFC Controlled Vocabularies for the Global Heat Flow Database. GFZ Data Services. https://doi.org/10.5880/fidgeo.2026.065"@en ;
    dcterms:title "IHFC Controlled Vocabularies for the Global Heat Flow Database"@en .

<https://ror.org/04z8jg394> a foaf:Organization ;
    foaf:homepage <https://www.gfz.de/en/> ;
    foaf:name "GFZ Helmholtz Centre for Geosciences"@en .

:unspecified a skos:Concept ;
    skos:definition "The geographic environment is not stated or not known."@en ;
    skos:inScheme ihfc:geographic-environments ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:geographic-environments .

<https://ihfc-iugg.org/> a foaf:Organization ;
    foaf:homepage <https://ihfc-iugg.org/> ;
    foaf:name "International Heat Flow Commission"@en .

:offshore_continental a skos:Concept ;
    skos:definition "The site is under the sea on continental crust, for example on the continental shelf or slope."@en ;
    skos:inScheme ihfc:geographic-environments ;
    skos:prefLabel "Offshore (continental)"@en ;
    skos:topConceptOf ihfc:geographic-environments .

:offshore_marine a skos:Concept ;
    skos:definition "The site is in the part of the ocean beyond the continental shelf edge. This includes deep-sea regions and open water with seamounts, mid-ocean ridges and abyssal plains."@en ;
    skos:inScheme ihfc:geographic-environments ;
    skos:prefLabel "Offshore (marine)"@en ;
    skos:topConceptOf ihfc:geographic-environments .

:onshore_continental a skos:Concept ;
    skos:definition "The site is on land, on continental crust."@en ;
    skos:inScheme ihfc:geographic-environments ;
    skos:prefLabel "Onshore (continental)"@en ;
    skos:topConceptOf ihfc:geographic-environments .

:onshore_marine a skos:Concept ;
    skos:definition "The site is on land but under inland water, for example the bed of a lake or river."@en ;
    skos:hiddenLabel "Onshore (lake-river-etc.)"@en ;
    skos:inScheme ihfc:geographic-environments ;
    skos:prefLabel "Onshore (lake, river, etc.)"@en ;
    skos:topConceptOf ihfc:geographic-environments .

ihfc:geographic-environments a skos:ConceptScheme ;
    dcterms:creator <https://ihfc-iugg.org/> ;
    dcterms:description "The basic geographic environment in which a heat-flow measurement was made, onshore or offshore."@en ;
    dcterms:isPartOf <https://doi.org/10.5880/fidgeo.2026.065> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://ror.org/04z8jg394> ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    rdfs:seeAlso <https://github.com/ihfc-iugg/controlled-vocabularies> ;
    skos:hasTopConcept :offshore_continental,
        :offshore_marine,
        :onshore_continental,
        :onshore_marine,
        :unspecified ;
    skos:prefLabel "Geographic environments"@en ;
    skos:scopeNote "Lists the values allowed in the field environment of the Global Heat Flow Database."@en .

