@prefix : <https://w3id.org/ihfc-iugg/vocabularies/conductivity-methods/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ihfc: <https://w3id.org/ihfc-iugg/vocabularies/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:estimation a skos:Collection ;
    skos:definition "Methods that estimate the conductivity from other properties or data instead of measuring it."@en ;
    skos:member :chlorineContent,
        :lithology,
        :mineralComposition,
        :waterContent ;
    skos:prefLabel "Estimation"@en .

:laboratory a skos:Collection ;
    skos:definition "Methods that measure the conductivity of rock samples in a laboratory."@en ;
    skos:member :laboratoryOther,
        :lineSourceFull,
        :lineSourceHalf,
        :planeSourceFull,
        :planeSourceHalf,
        :pointSource ;
    skos:prefLabel "Laboratory"@en .

:other a skos:Collection ;
    skos:definition "Values that name no specific method."@en ;
    skos:member :unspecified ;
    skos:prefLabel "Not specified"@en .

:probe a skos:Collection ;
    skos:definition "Methods that measure the conductivity in the ground with a probe."@en ;
    skos:member :probeContinuousHeating,
        :probePulse ;
    skos:prefLabel "Probe"@en .

:well_log a skos:Collection ;
    skos:definition "Methods that derive the conductivity from well-log data."@en ;
    skos:member :wellLogDeterministic,
        :wellLogEmpirical ;
    skos:prefLabel "Well-log"@en .

<https://doi.org/10.31214/ijthfa.v4i1.62> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Beardsmore, G., Chiozzi, P., Espinoza-Ojeda, O. M., Gola, G., Gosnold, W., Harris, R., Jennings, S., Liu, S., Negrete-Aranda, R., Neumann, F., Norden, B., Poort, J., Rajver, D., Ray, L., Richards, M., Smith, J., Tanaka, A., and Verdoya, M. (2021). A new database structure for the IHFC Global Heat Flow Database. International Journal of Terrestrial Heat Flow and Applied Geothermics, 4(1), 1–14."@en .

<https://doi.org/10.5880/fidgeo.2026.065> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Jennings, Samuel; Neumann, Florian; Norden, Ben; Balkan-Pazvantoğlu, Elif; Elbarbary, Samah; Petrunin, Alexey G.; Elger, Kirsten; Fuchs, Sven (2026): IHFC Controlled Vocabularies for the Global Heat Flow Database. GFZ Data Services. https://doi.org/10.5880/fidgeo.2026.065"@en ;
    dcterms:title "IHFC Controlled Vocabularies for the Global Heat Flow Database"@en .

<https://ror.org/04z8jg394> a foaf:Organization ;
    foaf:homepage <https://www.gfz.de/en/> ;
    foaf:name "GFZ Helmholtz Centre for Geosciences"@en .

<https://ihfc-iugg.org/> a foaf:Organization ;
    foaf:homepage <https://ihfc-iugg.org/> ;
    foaf:name "International Heat Flow Commission"@en .

:chlorineContent a skos:Concept ;
    skos:definition "The conductivity was estimated from the chlorine content."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Estimation - from chlorine content"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:laboratoryOther a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "A laboratory measurement method not listed here. Describe it in the comment field."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - other"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:lineSourceFull a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:altLabel "Lab - line source / full space"@en ;
    skos:definition "Laboratory measurement with a line heat source in a full space, for example a needle probe."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - line source - full space"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:lineSourceHalf a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:altLabel "Lab - line source / half space"@en ;
    skos:definition "Laboratory measurement with a line heat source in a half space, for example the TK04 device."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - line source - half space"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:lithology a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "The conductivity was estimated by assigning published values to the lithology."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Estimation - from lithology and literature"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:mineralComposition a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "The conductivity was estimated from the mineral composition with a mixing model."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Estimation - from mineral composition"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:planeSourceFull a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:altLabel "Lab - plane source / full space"@en ;
    skos:definition "Laboratory measurement with a plane heat source in a full space, for example a Hot Disk transient plane source, a comparator apparatus or a divided bar."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - plane source - full space"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:planeSourceHalf a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:altLabel "Lab - plane source / half space"@en ;
    skos:definition "Laboratory measurement with a plane heat source in a half space, for example a modified transient plane source device."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - plane source - half space"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:pointSource a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "Laboratory measurement with a point heat source, for example optical scanning with a thermal conductivity scanner."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - point source"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:probeContinuousHeating a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "In-situ measurement in soft sediment by continuously heating a line source in the probe and recording the temperature rise."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Probe - continuous heating technique"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:probePulse a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "In-situ measurement in soft sediment by recording the temperature rise and decay after a calibrated heat pulse from a heater in the probe, as in the violin-bow probe."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Probe - pulse technique"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:unspecified a skos:Concept ;
    skos:definition "The method used to determine the conductivity is not specified."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:waterContent a skos:Concept ;
    skos:altLabel "Estimation - from water content/porosity"@en ;
    skos:definition "The conductivity was estimated from the water content or the porosity."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Estimation - from water content-porosity"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:wellLogDeterministic a skos:Concept ;
    skos:definition "The conductivity was calculated from well logs by deriving the rock composition and combining the conductivities of its components."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Well-log - deterministic approach"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

:wellLogEmpirical a skos:Concept ;
    skos:definition "The conductivity was calculated from well logs with an empirical equation that relates log readings to conductivity."@en ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Well-log - empirical equation"@en ;
    skos:topConceptOf ihfc:conductivity-methods .

<https://doi.org/10.1016/j.tecto.2023.229976> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Norden, B., Neumann, F., Kaul, N., Tanaka, A., Kukkonen, I. T., et al. (2023). Quality-assurance of heat-flow data: The new structure and evaluation scheme of the IHFC Global Heat Flow Database. Tectonophysics, 863, 229976."@en .

ihfc:conductivity-methods a skos:ConceptScheme ;
    dcterms:creator <https://ihfc-iugg.org/> ;
    dcterms:description "Methods used to determine thermal conductivity, by laboratory measurement, in-situ probe, well-log interpretation or estimation."@en ;
    dcterms:isPartOf <https://doi.org/10.5880/fidgeo.2026.065> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://ror.org/04z8jg394> ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    rdfs:seeAlso <https://github.com/ihfc-iugg/controlled-vocabularies> ;
    skos:hasTopConcept :chlorineContent,
        :laboratoryOther,
        :lineSourceFull,
        :lineSourceHalf,
        :lithology,
        :mineralComposition,
        :planeSourceFull,
        :planeSourceHalf,
        :pointSource,
        :probeContinuousHeating,
        :probePulse,
        :unspecified,
        :waterContent,
        :wellLogDeterministic,
        :wellLogEmpirical ;
    skos:prefLabel "Thermal conductivity methods"@en ;
    skos:scopeNote "Lists the values allowed in the field tc_method of the Global Heat Flow Database."@en .

