@prefix : <https://w3id.org/ihfc-iugg/vocabularies/conductivity-sources/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ihfc: <https://w3id.org/ihfc-iugg/vocabularies/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:computation a skos:Collection ;
    skos:definition "Sources where the conductivity was computed or taken from published values, not measured."@en ;
    skos:member :assumed_from_literature,
        :mineral_computation ;
    skos:prefLabel "Computation"@en .

:in_situ a skos:Collection ;
    skos:definition "Sources where the conductivity was obtained in the ground, by a probe or from well logs."@en ;
    skos:member :insitu_probe,
        :well_log ;
    skos:prefLabel "In-situ"@en .

:laboratory a skos:Collection ;
    skos:definition "Sources where the conductivity was measured on rock material in a laboratory, including core measurements combined with logs."@en ;
    skos:member :core_log,
        :core_samples,
        :cutting_samples,
        :outcrop_samples ;
    skos:prefLabel "Laboratory"@en .

<https://doi.org/10.1016/j.tecto.2023.229976> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Norden, B., Neumann, F., Kaul, N., Tanaka, A., Kukkonen, I. T., et al. (2023). Quality-assurance of heat-flow data: The new structure and evaluation scheme of the IHFC Global Heat Flow Database. Tectonophysics, 863, 229976."@en .

<https://doi.org/10.31214/ijthfa.v4i1.62> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Beardsmore, G., Chiozzi, P., Espinoza-Ojeda, O. M., Gola, G., Gosnold, W., Harris, R., Jennings, S., Liu, S., Negrete-Aranda, R., Neumann, F., Norden, B., Poort, J., Rajver, D., Ray, L., Richards, M., Smith, J., Tanaka, A., and Verdoya, M. (2021). A new database structure for the IHFC Global Heat Flow Database. International Journal of Terrestrial Heat Flow and Applied Geothermics, 4(1), 1–14."@en .

<https://doi.org/10.5880/fidgeo.2026.065> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Jennings, Samuel; Neumann, Florian; Norden, Ben; Balkan-Pazvantoğlu, Elif; Elbarbary, Samah; Petrunin, Alexey G.; Elger, Kirsten; Fuchs, Sven (2026): IHFC Controlled Vocabularies for the Global Heat Flow Database. GFZ Data Services. https://doi.org/10.5880/fidgeo.2026.065"@en ;
    dcterms:title "IHFC Controlled Vocabularies for the Global Heat Flow Database"@en .

<https://ror.org/04z8jg394> a foaf:Organization ;
    foaf:homepage <https://www.gfz.de/en/> ;
    foaf:name "GFZ Helmholtz Centre for Geosciences"@en .

:other a skos:Concept ;
    skos:definition "The conductivity comes from a source not listed here. Describe it in the comment field."@en ;
    skos:inScheme ihfc:conductivity-sources ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf ihfc:conductivity-sources .

:unspecified a skos:Concept ;
    skos:definition "The source of the conductivity is not specified."@en ;
    skos:inScheme ihfc:conductivity-sources ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:conductivity-sources .

<https://ihfc-iugg.org/> a foaf:Organization ;
    foaf:homepage <https://ihfc-iugg.org/> ;
    foaf:name "International Heat Flow Commission"@en .

:assumed_from_literature a skos:Concept ;
    skos:definition "The conductivity was not measured for this heat-flow determination. It was taken from published values."@en ;
    skos:inScheme ihfc:conductivity-sources ;
    skos:prefLabel "Assumed from literature"@en ;
    skos:topConceptOf ihfc:conductivity-sources .

:core_log a skos:Concept ;
    skos:definition "The conductivity combines measurements on core samples with well-log data."@en ;
    skos:inScheme ihfc:conductivity-sources ;
    skos:prefLabel "Core-log integration"@en ;
    skos:topConceptOf ihfc:conductivity-sources .

:core_samples a skos:Concept ;
    skos:definition "The conductivity was measured on rock core samples recovered from a borehole."@en ;
    skos:inScheme ihfc:conductivity-sources ;
    skos:prefLabel "Core samples"@en ;
    skos:topConceptOf ihfc:conductivity-sources .

:cutting_samples a skos:Concept ;
    skos:definition "The conductivity was measured on rock cuttings brought up during drilling."@en ;
    skos:inScheme ihfc:conductivity-sources ;
    skos:prefLabel "Cutting samples"@en ;
    skos:topConceptOf ihfc:conductivity-sources .

:insitu_probe a skos:Concept ;
    skos:definition "The conductivity was measured in the ground with a probe, for example a probe pushed into soft sediment."@en ;
    skos:inScheme ihfc:conductivity-sources ;
    skos:prefLabel "In-situ probe"@en ;
    skos:topConceptOf ihfc:conductivity-sources .

:mineral_computation a skos:Concept ;
    skos:definition "The conductivity was calculated from the mineral composition of the rock, using the conductivities of the minerals."@en ;
    skos:inScheme ihfc:conductivity-sources ;
    skos:prefLabel "Mineral computation"@en ;
    skos:topConceptOf ihfc:conductivity-sources .

:outcrop_samples a skos:Concept ;
    skos:definition "The conductivity was measured on rock samples collected at the surface from outcrops."@en ;
    skos:inScheme ihfc:conductivity-sources ;
    skos:prefLabel "Outcrop samples"@en ;
    skos:topConceptOf ihfc:conductivity-sources .

:well_log a skos:Concept ;
    skos:definition "The conductivity was derived by interpreting well logs."@en ;
    skos:inScheme ihfc:conductivity-sources ;
    skos:prefLabel "Well-log interpretation"@en ;
    skos:topConceptOf ihfc:conductivity-sources .

ihfc:conductivity-sources a skos:ConceptScheme ;
    dcterms:creator <https://ihfc-iugg.org/> ;
    dcterms:description "The material or data the thermal conductivity values were obtained from, such as core samples, well logs or the literature."@en ;
    dcterms:isPartOf <https://doi.org/10.5880/fidgeo.2026.065> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://ror.org/04z8jg394> ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    rdfs:seeAlso <https://github.com/ihfc-iugg/controlled-vocabularies> ;
    skos:hasTopConcept :assumed_from_literature,
        :core_log,
        :core_samples,
        :cutting_samples,
        :insitu_probe,
        :mineral_computation,
        :other,
        :outcrop_samples,
        :unspecified,
        :well_log ;
    skos:prefLabel "Thermal conductivity sources"@en ;
    skos:scopeNote "Lists the values allowed in the field tc_source of the Global Heat Flow Database."@en .

