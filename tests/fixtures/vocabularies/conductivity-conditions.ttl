@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ihfc: <https://w3id.org/ihfc-iugg/vocabularies/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:actual a skos:Collection ;
    skos:definition "Determinations made at the actual conditions of the depth interval of the heat-flow determination."@en ;
    skos:member :actualInSitu ;
    skos:prefLabel "Actual conditions"@en .

:corrected a skos:Collection ;
    skos:definition "Determinations made under laboratory pressure and temperature conditions and then corrected to the conditions of the target depth."@en ;
    skos:member :correctedP,
        :correctedPT,
        :correctedT ;
    skos:prefLabel "Corrected conditions"@en .

:recorded a skos:Collection ;
    skos:definition "Determinations whose pressure and temperature conditions were recorded when the conductivity was measured."@en ;
    skos:member :recordedAmbient ;
    skos:prefLabel "Recorded conditions"@en .

:replicated a skos:Collection ;
    skos:definition "Determinations where the conditions of the target depth are replicated under laboratory conditions."@en ;
    skos:member :replicatedP,
        :replicatedPT,
        :replicatedT ;
    skos:prefLabel "Replicated conditions"@en .

