:actual a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "The conductivity data come from the same location as the heat-flow determination."@en ;
    skos:inScheme ihfc:conductivity-location ;
    skos:prefLabel "Actual heat-flow location"@en ;
    skos:topConceptOf ihfc:conductivity-location .

:literature a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:altLabel "Literature/unspecified"@en ;
    skos:definition "The conductivity comes from published values, or its location is not known. Use it only when the conductivity source is assumed from literature."@en ;
    skos:hiddenLabel "Literature-unspecified"@en ;
    skos:inScheme ihfc:conductivity-location ;
    skos:prefLabel "Literature or unspecified"@en ;
    skos:topConceptOf ihfc:conductivity-location .

:other a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "The conductivity data come from a nearby or other location than the heat-flow determination."@en ;
    skos:inScheme ihfc:conductivity-location ;
    skos:prefLabel "Other location"@en ;
    skos:topConceptOf ihfc:conductivity-location .

<https://ihfc-iugg.org/> a foaf:Organization ;
    foaf:homepage <https://ihfc-iugg.org/> ;
    foaf:name "International Heat Flow Commission"@en .

<https://doi.org/10.1016/j.tecto.2023.229976> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Norden, B., Neumann, F., Kaul, N., Tanaka, A., Kukkonen, I. T., et al. (2023). Quality-assurance of heat-flow data: The new structure and evaluation scheme of the IHFC Global Heat Flow Database. Tectonophysics, 863, 229976."@en .

ihfc:conductivity-location a skos:ConceptScheme ;
    dcterms:creator <https://ihfc-iugg.org/> ;
    dcterms:description "Where the thermal conductivity used for a heat-flow value was measured, relative to the heat-flow site."@en ;
