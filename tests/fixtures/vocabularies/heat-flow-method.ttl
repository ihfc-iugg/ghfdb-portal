    dcterms:publisher <https://ror.org/04z8jg394> ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    rdfs:seeAlso <https://github.com/ihfc-iugg/controlled-vocabularies> ;
    skos:hasTopConcept :bootstrap,
        :bullard,
        :interval,
        :numerical,
        :other,
        :unspecified ;
    skos:prefLabel "Heat-flow methods"@en ;
    skos:scopeNote "Lists the values allowed in the field q_method of the Global Heat Flow Database."@en .

