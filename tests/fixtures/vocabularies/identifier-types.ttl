PREFIX : <https://w3id.org/fairdm/vocabularies/identifier-types/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fairdm: <https://w3id.org/fairdm/vocabularies/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<https://www.fairdm.org/>
    a foaf:Organization ;
    foaf:homepage <https://www.fairdm.org/> ;
    foaf:name "FairDM"@en ;
.

fairdm:identifier-types
    a skos:ConceptScheme ;
    dcterms:creator <https://www.fairdm.org/> ;
    dcterms:description "Kinds of persistent identifier recorded for projects, datasets, samples, measurements, people and organizations."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://www.fairdm.org/> ;
    rdfs:seeAlso <https://github.com/FAIR-DM/fairdm-vocabularies> ;
    skos:hasTopConcept
        :crossref-funder-id ,
        :doi ,
        :grant-number ,
        :igsn ,
        :isni ,
        :orcid ,
        :proposal-id ,
        :researcher-id ,
        :ror ,
        :wikidata ;
    skos:prefLabel "Identifier types"@en ;
.

:contributor
    a skos:OrderedCollection ;
    skos:definition "Persistent identifiers for people and organizations - the union of the person and organization identifier collections."@en ;
    skos:memberList (
        :orcid
        :researcher-id
        :ror
        :wikidata
        :isni
        :crossref-funder-id
    ) ;
    skos:prefLabel "Contributor Identifiers"@en ;
.

:dataset
    a skos:OrderedCollection ;
    skos:definition "Persistent identifiers for research datasets."@en ;
    skos:memberList (
        :doi
    ) ;
    skos:prefLabel "Dataset Identifiers"@en ;
.

:measurement
    a skos:OrderedCollection ;
    skos:definition "Persistent identifiers for research measurements."@en ;
    skos:memberList (
        :doi
    ) ;
    skos:prefLabel "Measurement Identifiers"@en ;
.

:organization
    a skos:OrderedCollection ;
    skos:definition "Persistent identifiers for research organizations and institutions."@en ;
    skos:memberList (
        :ror
        :wikidata
        :isni
        :crossref-funder-id
    ) ;
    skos:prefLabel "Organization Identifiers"@en ;
.

:person
    a skos:OrderedCollection ;
    skos:definition "Persistent identifiers for individual researchers and scholars."@en ;
    skos:memberList (
        :orcid
        :researcher-id
    ) ;
    skos:prefLabel "Person Identifiers"@en ;
.

:project
    a skos:OrderedCollection ;
    skos:definition "Persistent identifiers for research projects."@en ;
    skos:memberList (
        :doi
        :grant-number
        :proposal-id
    ) ;
    skos:prefLabel "Project Identifiers"@en ;
.

:sample
    a skos:OrderedCollection ;
    skos:definition "Persistent identifiers for physical specimens."@en ;
    skos:memberList (
        :igsn
        :doi
    ) ;
    skos:prefLabel "Sample Identifiers"@en ;
.

:crossref-funder-id
    a skos:Concept ;
    dcterms:source <https://www.crossref.org/fundingdata/> ;
    skos:closeMatch <http://purl.org/spar/datacite/fundref> ;
    skos:definition "An identifier assigned by Crossref to uniquely identify funding organizations."@en ;
    skos:inScheme fairdm:identifier-types ;
    skos:notation "CROSSREF_FUNDER_ID" ;
    skos:prefLabel "Crossref Funder ID"@en ;
    skos:topConceptOf fairdm:identifier-types ;
.

:doi
    a skos:Concept ;
    dcterms:source <https://www.doi.org/doi_handbook/> ;
    skos:definition "A Digital Object Identifier providing a persistent, resolvable link to a record."@en ;
    skos:exactMatch <http://purl.org/spar/datacite/doi> ;
    skos:inScheme fairdm:identifier-types ;
    skos:notation "DOI" ;
    skos:prefLabel "DOI"@en ;
    skos:topConceptOf fairdm:identifier-types ;
.

:grant-number
    a skos:Concept ;
    skos:definition "The identifier assigned by a funder to a grant that supports the project, used to reconcile the project against the funder's own records."@en ;
    skos:inScheme fairdm:identifier-types ;
    skos:notation "GRANT_NUMBER" ;
    skos:prefLabel "Grant Number"@en ;
    skos:topConceptOf fairdm:identifier-types ;
.

:igsn
    a skos:Concept ;
    dcterms:source <https://igsn.org/> ;
    skos:definition "The International Generic Sample Number, a persistent identifier for physical specimens. Registration moved to DataCite in 2023; legacy handles still resolve."@en ;
    skos:exactMatch <http://purl.org/spar/datacite/igsn> ;
    skos:inScheme fairdm:identifier-types ;
    skos:notation "IGSN" ;
    skos:prefLabel "IGSN"@en ;
    skos:topConceptOf fairdm:identifier-types ;
.

:isni
    a skos:Concept ;
    dcterms:source <https://www.isni.org/> ;
    skos:definition "An International Standard Name Identifier (ISNI) used to uniquely identify individuals and organizations involved in creative activities."@en ;
    skos:exactMatch <http://purl.org/spar/datacite/isni> ;
    skos:inScheme fairdm:identifier-types ;
    skos:notation "ISNI" ;
    skos:prefLabel "ISNI"@en ;
    skos:topConceptOf fairdm:identifier-types ;
.

:orcid
    a skos:Concept ;
    dcterms:source <http://orcid.org/> ;
    skos:definition "A persistent digital identifier that uniquely identifies researchers and scholars, ensuring correct attribution of their work."@en ;
    skos:exactMatch <http://purl.org/spar/datacite/orcid> ;
    skos:inScheme fairdm:identifier-types ;
    skos:notation "ORCID" ;
    skos:prefLabel "ORCID iD"@en ;
    skos:topConceptOf fairdm:identifier-types ;
.

:proposal-id
    a skos:Concept ;
    skos:definition "The identifier assigned to the proposal from which the project originated."@en ;
    skos:inScheme fairdm:identifier-types ;
    skos:notation "PROPOSAL_ID" ;
    skos:prefLabel "Proposal Identifier"@en ;
    skos:topConceptOf fairdm:identifier-types ;
.

:researcher-id
    a skos:Concept ;
    dcterms:source <https://www.researcherid.com/> ;
    skos:definition "An identifier assigned to researchers by Web of Science to track author publications."@en ;
    skos:exactMatch <http://purl.org/spar/datacite/researcherid> ;
    skos:inScheme fairdm:identifier-types ;
    skos:notation "RESEARCHER_ID" ;
    skos:prefLabel "ResearcherID"@en ;
    skos:topConceptOf fairdm:identifier-types ;
.

:ror
    a skos:Concept ;
    dcterms:source <https://ror.org/> ;
    skos:definition "A unique identifier for research organizations, provided by the Research Organization Registry (ROR)."@en ;
    skos:exactMatch <http://purl.org/spar/datacite/ror> ;
    skos:inScheme fairdm:identifier-types ;
    skos:notation "ROR" ;
    skos:prefLabel "ROR"@en ;
    skos:topConceptOf fairdm:identifier-types ;
.

:wikidata
    a skos:Concept ;
    dcterms:source <https://www.wikidata.org/> ;
    skos:definition "A free and open knowledge base that provides structured data, including identifiers for people, organizations, and concepts."@en ;
    skos:exactMatch <http://purl.org/spar/datacite/wikidata> ;
    skos:inScheme fairdm:identifier-types ;
    skos:notation "WIKIDATA" ;
    skos:prefLabel "Wikidata"@en ;
    skos:topConceptOf fairdm:identifier-types ;
.
