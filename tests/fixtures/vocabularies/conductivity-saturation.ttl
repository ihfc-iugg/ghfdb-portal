:dryMeasured a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    skos:definition "The rocks were technically dried before the measurement."@en ;
    skos:inScheme ihfc:conductivity-saturation ;
    skos:notation "drymeas" ;
    skos:prefLabel "Dry measured"@en ;
    skos:topConceptOf ihfc:conductivity-saturation .

:other a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    skos:definition "The saturation state is not one of the listed states. Describe it in the comment field."@en ;
    skos:inScheme ihfc:conductivity-saturation ;
    skos:notation "other" ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf ihfc:conductivity-saturation .

:recovered a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    skos:definition "The rocks were preserved and measured in a state close to their natural saturation."@en ;
    skos:inScheme ihfc:conductivity-saturation ;
    skos:notation "recov" ;
    skos:prefLabel "Recovered"@en ;
    skos:topConceptOf ihfc:conductivity-saturation .

:saturatedCalculated a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    skos:definition "The conductivity was calculated from dry-measured rocks, the porosity and the pore-filling fluid."@en ;
    skos:inScheme ihfc:conductivity-saturation ;
    skos:notation "satcalc" ;
    skos:prefLabel "Saturated calculated"@en ;
    skos:topConceptOf ihfc:conductivity-saturation .

:saturatedInSitu a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    skos:altLabel "Saturated measured insitu"@en ;
    skos:definition "The conductivity was measured on saturated material in the ground, by probe sensing or in marine measurements."@en ;
    skos:inScheme ihfc:conductivity-saturation ;
    skos:notation "insitusatmeas" ;
    skos:prefLabel "Saturated measured in-situ"@en ;
    skos:topConceptOf ihfc:conductivity-saturation .

:saturatedMeasured a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    skos:definition "The rocks were technically saturated completely before the measurement."@en ;
    skos:inScheme ihfc:conductivity-saturation ;
    skos:notation "satmeas" ;
    skos:prefLabel "Saturated measured"@en ;
    skos:topConceptOf ihfc:conductivity-saturation .

:unspecified a skos:Concept ;
    skos:definition "The saturation state is not specified."@en ;
    skos:inScheme ihfc:conductivity-saturation ;
    skos:notation "unspec" ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:conductivity-saturation .

