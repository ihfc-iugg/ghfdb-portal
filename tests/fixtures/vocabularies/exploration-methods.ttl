@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ihfc: <https://w3id.org/ihfc-iugg/vocabularies/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://doi.org/10.31214/ijthfa.v4i1.62> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Beardsmore, G., Chiozzi, P., Espinoza-Ojeda, O. M., Gola, G., Gosnold, W., Harris, R., Jennings, S., Liu, S., Negrete-Aranda, R., Neumann, F., Norden, B., Poort, J., Rajver, D., Ray, L., Richards, M., Smith, J., Tanaka, A., and Verdoya, M. (2021). A new database structure for the IHFC Global Heat Flow Database. International Journal of Terrestrial Heat Flow and Applied Geothermics, 4(1), 1–14."@en .

<https://doi.org/10.5880/fidgeo.2026.065> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Jennings, Samuel; Neumann, Florian; Norden, Ben; Balkan-Pazvantoğlu, Elif; Elbarbary, Samah; Petrunin, Alexey G.; Elger, Kirsten; Fuchs, Sven (2026): IHFC Controlled Vocabularies for the Global Heat Flow Database. GFZ Data Services. https://doi.org/10.5880/fidgeo.2026.065"@en ;
    dcterms:title "IHFC Controlled Vocabularies for the Global Heat Flow Database"@en .

<https://ror.org/04z8jg394> a foaf:Organization ;
    foaf:homepage <https://www.gfz.de/en/> ;
    foaf:name "GFZ Helmholtz Centre for Geosciences"@en .

:drilling a skos:Concept ;
    skos:definition "The temperature sensors reached the rock through a borehole."@en ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Drilling"@en ;
    skos:topConceptOf ihfc:exploration-methods .

:drilling_clustering a skos:Concept ;
    skos:definition "Drilling in which the entry stands for a cluster of boreholes close together rather than for a single borehole."@en ;
    skos:hiddenLabel "Drilling-Clustering"@en ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Drilling (clustered)"@en ;
    skos:topConceptOf ihfc:exploration-methods .

:indirect a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "No sensor reached the rock. Subsurface temperature is estimated from other data, such as geothermometers (GTM), bottom-simulating reflectors (BSR) or Curie point depth (CPD)."@en ;
    skos:hiddenLabel "Indirect (GTM-BSR-CPD-etc.)"@en ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Indirect (GTM, BSR, CPD, etc.)"@en ;
    skos:topConceptOf ihfc:exploration-methods .

:mining a skos:Concept ;
    skos:definition "The temperature sensors reached the rock through a mine."@en ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Mining"@en ;
    skos:topConceptOf ihfc:exploration-methods .

:other a skos:Concept ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976> ;
    skos:definition "Access by a means not listed here. The contributor names it in the comments."@en ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf ihfc:exploration-methods .

:probing_clustering a skos:Concept ;
    skos:definition "Probing in which the entry stands for a cluster of probe penetrations close together rather than for a single penetration."@en ;
    skos:hiddenLabel "Probing-Clustering"@en ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Probing (clustered)"@en ;
    skos:topConceptOf ihfc:exploration-methods .

:probing_offshore a skos:Concept ;
    skos:altLabel "Probing (offshore/ocean)"@en ;
    skos:definition "A probe was pushed into soft sediment at the sea floor."@en ;
    skos:hiddenLabel "Probing (offshore-ocean)"@en ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Probing (offshore, ocean)"@en ;
    skos:topConceptOf ihfc:exploration-methods .

:probing_onshore a skos:Concept ;
    skos:altLabel "Probing (onshore/lake, river, etc.)"@en ;
    skos:definition "A probe was pushed into soft sediment on land or at the bed of a lake, river or other inland water."@en ;
    skos:hiddenLabel "Probing (onshore-lake-river-etc.)"@en ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Probing (onshore, lake, river, etc.)"@en ;
    skos:topConceptOf ihfc:exploration-methods .

:tunneling a skos:Concept ;
    skos:definition "The temperature sensors reached the rock through a tunnel."@en ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Tunneling"@en ;
    skos:topConceptOf ihfc:exploration-methods .

:unspecified a skos:Concept ;
    skos:definition "The means of access is not stated or not known."@en ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:exploration-methods .

<https://ihfc-iugg.org/> a foaf:Organization ;
    foaf:homepage <https://ihfc-iugg.org/> ;
    foaf:name "International Heat Flow Commission"@en .

<https://doi.org/10.1016/j.tecto.2023.229976> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Norden, B., Neumann, F., Kaul, N., Tanaka, A., Kukkonen, I. T., et al. (2023). Quality-assurance of heat-flow data: The new structure and evaluation scheme of the IHFC Global Heat Flow Database. Tectonophysics, 863, 229976."@en .

ihfc:exploration-methods a skos:ConceptScheme ;
    dcterms:creator <https://ihfc-iugg.org/> ;
    dcterms:description "The general means by which temperature sensors gained access to the rock, such as drilling, probing, mining or tunnelling."@en ;
    dcterms:isPartOf <https://doi.org/10.5880/fidgeo.2026.065> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://ror.org/04z8jg394> ;
    dcterms:source <https://doi.org/10.1016/j.tecto.2023.229976>,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    rdfs:seeAlso <https://github.com/ihfc-iugg/controlled-vocabularies> ;
    skos:hasTopConcept :drilling,
        :drilling_clustering,
        :indirect,
        :mining,
        :other,
        :probing_clustering,
        :probing_offshore,
        :probing_onshore,
        :tunneling,
        :unspecified ;
    skos:prefLabel "Exploration methods"@en ;
    skos:scopeNote "Lists the values allowed in the field explo_method of the Global Heat Flow Database."@en .

