#!/bin/sh
# Refresh the controlled vocabularies from their published addresses, so a new release of a
# vocabulary reaches the portal on its next start (deploy/README.md). A vocabulary server that
# does not answer leaves the terms already loaded in place, so it never stops the portal.
set -u
python manage.py sync_vocabularies \
  || echo "sync_vocabularies failed: serving with the vocabularies already loaded." >&2
